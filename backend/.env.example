NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/menaml_dev

# Auth
JWT_SECRET=change-me-in-production
# Cookie domain — share the JWT across all *.mena.ml subdomains (SSO).
# In local dev use ".localhost" so agency.localhost / organizer.localhost share it.
COOKIE_DOMAIN=.localhost

# CORS — comma-separated list of allowed portal origins
CORS_ORIGINS=http://organizer.localhost:5001,http://agency.localhost:5002,http://sponsor.localhost:5003,http://reviewer.localhost:5004,http://participant.localhost:5005
