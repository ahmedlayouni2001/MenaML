{
  "name": "menaml",
  "private": true,
  "version": "0.1.0",
  "description": "MenaML — multi-portal platform (organizer, travel-agency, sponsor, reviewer, participant)",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:backend": "pnpm --filter @mena/backend dev",
    "dev:agency": "pnpm --filter @mena/travel-agency dev"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
